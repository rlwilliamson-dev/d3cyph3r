{
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=(), browsing-topics=()",
    "Cross-Origin-Opener-Policy": "same-origin",
    "Cross-Origin-Embedder-Policy": "require-corp",
    "Cross-Origin-Resource-Policy": "cross-origin",
    "X-Permitted-Cross-Domain-Policies": "none"
  },
  "routes": [
    {
      "route": "/",
      "headers": { "Cache-Control": "no-cache, must-revalidate" }
    },
    {
      "route": "/index.html",
      "headers": { "Cache-Control": "no-cache, must-revalidate" }
    },
    {
      "route": "/walkthroughs/",
      "headers": { "Cache-Control": "no-cache, must-revalidate" }
    },
    {
      "route": "/walkthroughs/index.html",
      "headers": { "Cache-Control": "no-cache, must-revalidate" }
    },
    {
      "route": "/js/*",
      "headers": { "Cache-Control": "no-cache, must-revalidate" }
    },
    {
      "route": "/levels/*",
      "headers": { "Cache-Control": "no-cache, must-revalidate" }
    },
    {
      "route": "/walkthroughs/walkthrough.js",
      "headers": { "Cache-Control": "no-cache, must-revalidate" }
    },
    {
      "route": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache, must-revalidate",
        "Service-Worker-Allowed": "/"
      }
    },
    {
      "route": "/manifest.webmanifest",
      "headers": {
        "Cache-Control": "no-cache, must-revalidate",
        "Content-Type": "application/manifest+json"
      }
    },
    {
      "route": "/icon-*.png",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/favicon.svg",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  }
}
